# Internal Caddyfile for the `builderapps-web` container. The SHARED Caddy
# (deploy-caddy-1) reverse-proxies builderapps.osmike.com -> this container:80.
# Generated project apps are NOT served here — they live on the wildcard
# *.builderapps.osmike.com and are routed by the shared Caddy directly.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	root * /srv/spa

	# The SPA is served straight out of a git checkout that is `git pull`ed in
	# place, so a deploy changes files under a URL the browser has already seen.
	# Without an explicit directive Chrome applies HEURISTIC caching and can keep
	# running an old app.js after a deploy — which looks exactly like a bug that
	# "isn't fixed". `no-cache` still allows caching, it just forces revalidation,
	# and the file_server's ETag/Last-Modified make that a cheap 304.
	header Cache-Control "no-cache"

	# Serve the SPA's own real files from disk when they exist (assets, app.js,
	# config.js, favicon, …). Everything else is a client-side route.
	@files file
	handle @files {
		file_server
	}

	# All client-side routes fall back to the SPA shell. These are real pushState
	# paths the app owns: /, /auth/callback, /builder, /apps, /settings, /profile,
	# /subscription (and any future ones). A catch-all -> index.html is correct
	# because generated project apps live on *.builderapps.osmike.com, not here.
	handle {
		rewrite * /index.html
		file_server
	}
}
